// Temporary: something for the sprite renderer to draw, until the generator
// and the population systems place the actors of the world.
//
// It is the survivor without the marker of the player, so that it is neither
// steered nor skipped by the renderer.
(
    components: [
        ("position", (16.0, 16.0, 16.0)),
        ("rotation", (0.0, 0.0, 0.0)),
        ("velocity", (0.0, 0.0, 0.0)),
        ("speed", (walk: 0.25, jump: 0.75)),
        ("bound", (min: (-0.25, 0.0, -0.25), max: (0.25, 1.5, 0.25))),
        ("eye", 1.25),
        // One layer, drawn at 1.0 by 2.0 blocks from the actor's feet.
        ("appearance", [
            Some((
                set: "humanoid",
                frame: "idle_0",
                size: (1.0, 2.0),
                offset: (0.0, 0.0, 0.0),
                uvs: (min: (0.0, 0.0), max: (1.0, 1.0)),
            )),
        ]),
        ("directional_facing", (layers: [0])),
    ],
)
