(
    version: 1,

    schema: (
        interval: 8,
        channels: [
            (name: "climate", components: 3),
            (name: "density", components: 1),
            (name: "erosion", components: 1),
            (name: "density_gradient", components: 3, gradient_of: "density"),
        ],
        halo: (
            density: "density",
            erosion: "erosion",
        ),
    ),

    structures: "assets/structures",

    stages: [
        (
            name: "base",
            kind: sample,
            module: "scripts/terrain.wasm",
            entry: "sample_base",
            writes: ["climate", "density", "erosion"],
        ),
        (
            name: "ground",
            kind: chunk,
            module: "scripts/terrain.wasm",
            entry: "ground",
        ),
        (
            name: "tree_sites",
            kind: place,
            module: "scripts/terrain.wasm",
            entry: "tree_sites",
            structure: "tree",
        ),
        (
            name: "camp_sites",
            kind: place,
            module: "scripts/terrain.wasm",
            entry: "camp_sites",
            structure: "camp",
        ),
        (
            name: "stamp_trees",
            kind: stamp,
            structure: "tree",
        ),
        (
            name: "stamp_camps",
            kind: stamp,
            structure: "camp",
        ),
        (
            name: "grass",
            kind: chunk,
            module: "scripts/terrain.wasm",
            entry: "grass",
        ),
    ],
)
